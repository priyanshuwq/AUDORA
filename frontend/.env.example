# Example environment variables for local development
# Copy this file to .env or .env.local at the project root and fill values.

# Clerk publishable key (client-side). Replace with your Clerk publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Media Base URL - where media files (songs, covers) are served from
# Leave empty or "/" for local development (files in public folder)
# For production, set to your media repo/CDN URL:
# - GitHub Pages: https://priyanshuwq.github.io/audora-media
# - Raw GitHub: https://raw.githubusercontent.com/priyanshuwq/audora-media/main
# - Self-hosted: https://media.yourdomain.com
VITE_MEDIA_BASE_URL=

# Other Vite env vars can go here
